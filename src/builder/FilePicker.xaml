<!-- 토렌트 안의 파일 중 완료 후 실행할 파일 고르기 -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L.picker.title}" Width="640" Height="540" MinWidth="440" MinHeight="340"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" UseLayoutRounding="True"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource UiFont}" FontSize="13" TextOptions.TextFormattingMode="Display">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{DynamicResource L.picker.title}" Style="{DynamicResource SectionText}" FontSize="18"/>
            <TextBlock Text="{DynamicResource L.picker.sub}"
                       Style="{DynamicResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,16,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Search" Padding="32,5,8,5"/>
            <TextBlock Text="&#xE721;" Style="{DynamicResource IconText}" FontSize="13" Margin="11,0,0,0" IsHitTestVisible="False"
                       Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Left"/>
            <TextBlock x:Name="SearchHint" Text="{DynamicResource L.picker.search}" Margin="33,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center"
                       Foreground="{DynamicResource SubTextBrush}"/>
            <CheckBox x:Name="ChkRunnable" Grid.Column="1" Margin="16,0,0,0" Style="{DynamicResource Switch}" Content="{DynamicResource L.picker.runnable}" IsChecked="True"/>
        </Grid>
        <Border Grid.Row="2" Style="{DynamicResource Card}" Padding="4" Margin="0">
            <ListBox x:Name="List" ItemContainerStyle="{DynamicResource ListItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Icon}" Style="{DynamicResource IconText}" FontSize="14" Margin="4,0,12,0"
                                       Foreground="{DynamicResource SubTextBrush}"/>
                            <TextBlock Text="{Binding Path}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <TextBlock x:Name="Count" Style="{DynamicResource CaptionText}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel" Content="{DynamicResource L.btn.cancel}" MinWidth="96" IsCancel="True"/>
                <Button x:Name="BtnOk" Style="{DynamicResource AccentButton}" Content="{DynamicResource L.btn.select}" MinWidth="96" Margin="8,0,0,0" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
